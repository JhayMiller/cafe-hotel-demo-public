# SOLO EJEMPLO. Copiar a .env en el servidor y rellenar; nunca subir .env a Drive ni Git.
# Host real con DNS A apuntando a la IP de Oracle. Sin https:// y sin / final.
APP_HOST=CAMBIAR_POR_SUBDOMINIO_DNS_REAL
# Identificadores para base de datos; use contraseña HEX aleatoria (sin símbolos URL especiales).
DB_NAME=cafe_hotel
DB_USER=cafehotel
DB_PASSWORD=CAMBIAR_CLAVE_HEX_LARGA
JWT_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_64_CARACTERES
PIN_PEPPER=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO_64_CARACTERES
# OPCIONALES: no activar pagos ni WhatsApp reales hasta pruebas y autorización.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_READY=
WHATSAPP_TEMPLATE_DISPATCHED=
